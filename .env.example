# ==============================================================================
# فایل نمونه متغیرهای محیطی ربات واسطه‌گری امن میانجی (Miyanji Escrow Bot)
# ==============================================================================

# ۱. توکن و نام کاربری ربات تلگرام (الزامی)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_USERNAME=mianji_ir_bot

# ۲. اتصال به پایگاه‌داده ابری Supabase (حیاتی برای جلوگیری از پاک شدن داده‌ها در رندر)
# حتماً این دو متغیر را در داشبورد Render -> Environment وارد کنید
# و اسکریپت supabase_schema.sql را در SQL Editor سوپابیس اجرا فرمایید.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ۳. شناسه‌های ادمین و مالک اصلی ربات (شناسه عددی تلگرام)
ADMIN_ID=1802649782
OWNER_ID=1802649782

# ۴. کانال‌های اطلاع‌رسانی، بایگانی و نظارت (شناسه‌های عددی تلگرام)
# کانال بایگانی و ثبت سوابق رسمی عملیات (تایید، لغو، رای داور بدون دکمه)
MJNOTE=-1003862335372
ARCHIVE_CHANNEL_ID=-1003862335372
# کانال معاملات عمومی (پست‌های شیشه‌ای)
MJCHNL=-1002738838047
# کانال اختصاصی مدیران جهت بررسی فیش‌ها
MJ_ADMIN=-1002738838047

# ۵. پورت اجرای سرور وب (در رندر معمولاً ۱۰ هزار یا پورت پیش‌فرض تعیین می‌شود)
PORT=3000

# ۶. درصد کارمزد پیش‌فرض و حد احراز هویت
COMMISSION_PERCENT=10.0
IDENTITY_VERIFICATION_THRESHOLD=3000000

# ۷. مسیر ذخیره دیسک پایدار (اختیاری - در صورت استفاده از Render Persistent Disk)
# DATA_DIR=/var/data